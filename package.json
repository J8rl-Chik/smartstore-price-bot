{
  "name": "smartstore-price-bot",
  "version": "1.0.0",
  "description": "Set price automatically",
  "main": "./out/main/index.cjs",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "lint": "eslint",
    "lint:style": "stylelint \"src/**/*.{ts,tsx,css}\"",
    "start:cli": "node dist/app.js",
    "start:electron": "electron .",
    "build:cli": "tsc -p tsconfig.base.json",
    "build:electron": "electron-vite build",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "dev:cli": "tsx src/app.ts",
    "typecheck": "tsc -p tsconfig.base.json && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "typecheck:watch": "concurrently \"tsc -p tsconfig.base.json --watch\" \"tsc -p tsconfig.node.json --noEmit --watch\" \"tsc -p tsconfig.web.json --noEmit --watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest --project browser --browser.headless=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "googleapis": "^173.0.0",
    "jsdom": "^24.1.0",
    "node-fetch": "^3.3.2",
    "postcss-styled-syntax": "^0.7.4",
    "prettier": "^3.9.10",
    "puppeteer": "^25.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-order": "^8.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.2.6",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
