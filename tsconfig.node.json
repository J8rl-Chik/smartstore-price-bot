{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  // [설정 상속]
  // Electron 툴킷 패키지에서 미리 만들어둔 표준 Node.js 타입스크립트 베이스 설정값을 그대로 물려받아(상속받아) 사용합니다.
  // 덕분에 복잡한 노드 관련 옵션들을 개발자가 일일이 직접 적지 않아도 기본 세팅이 깔끔하게 완료됩니다.

  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*"],
  // [검사 대상 폴더 지정]
  // 이 규칙 책으로 검사하고 관리할 파일들의 범위를 지정합니다.
  // 1. electron.vite.config.* : 프로젝트 최상위의 빌드 설정 파일들을 포함합니다.
  // 2. src/main/**/* : 메인 프로세스 폴더 안의 모든 파일과 하위 폴더들을 전부 검사합니다.
  // 3. src/preload/**/* : 프리로드 스크립트 폴더 안의 모든 파일과 하위 폴더들을 전부 검사합니다.

  "compilerOptions": {
    // 타입스크립트 컴파일러에게 세부적으로 명령을 내리는 옵션 창고입니다.

    "composite": true,
    // [프로젝트 참조 모드 활성화]
    // 마스터 파일(tsconfig.json)이 이 파일을 하위 프로젝트로 참조해서 유기적으로 연결할 수 있도록 허용하는 옵션입니다.
    // 이 옵션이 켜져 있어야 대형 프로젝트에서 빌드 속도가 빨라지고 마스터 파일의 'references' 기능이 정상 작동합니다.

    "types": ["electron-vite/node"]
    // [전용 타입 사전 등록]
    // 타입스크립트에게 "너 지금 Node.js 환경 검사 중이니까, 'electron-vite'가 제공하는 노드 전용 명령어 사전을 참고해서 검사해!"라고 알려주는 설정입니다.
    // 이 설정 덕분에 메인 프로세스 코드 안에서 빌드 도구 고유의 명령어들을 에러 없이 안전하게 인식할 수 있습니다.
  }
}
